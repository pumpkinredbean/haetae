  "semantic_invariants": {
    "common_rules": {
      "file_digest": "SHA256 of exact file bytes, with exact byte size. Keep file and content/self-digest identities separate.",
      "incomplete": "Publish the complete manifest last, after validation. On failed final verification remove the complete marker, preserve observations and publish a failed receipt. Readers require exact payload inventory.",
      "json": "UTF-8 strict JSON. Reject duplicate keys, numeric NaN/Infinity, unknown fields and Boolean values masquerading as integers. Split JSONL as bytes on newline so Unicode separators inside strings survive.",
      "paths": "Resolve artifact IDs through explicit roots. Reject traversal and symlinks; hash and parse the same captured bytes. Do not use broad globbing to discover evidence.",
      "publication": "Create outputs exclusively. Sync temporary files, publish without clobbering and sync their directory. Only mutable pointers owned by the new run may use atomic replacement.",
      "self_digest": "SHA256 of canonical JSON with only the object's own self-digest field omitted. ensure_ascii=False, sort_keys=True, separators=(comma,colon), allow_nan=False.",
      "self_hash_fields": {
        "initialization": "initialization_sha256",
        "manifest": "manifest_sha256",
        "pair_initialization": "pair_initialization_sha256",
        "pair_result": "result_sha256",
        "pilot_gate": "gate_sha256",
        "prediction_report": "report_sha256",
        "protocol": "protocol_sha256",
        "receipt": "receipt_sha256",
        "review_index": "index_sha256",
        "specification": "spec_sha256",
        "tape_row": "row_sha256"
      }
    },
    "freeze_status": "frozen_pre_m4; do not invent runtime tensor fingerprints before real initialization is authorized.",
    "frozen_manifest_files": [
