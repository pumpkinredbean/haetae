{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pumpkinredbean/haetae/research/evidence/schema.json",
  "title": "Haetae evidence registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base_commit",
    "reference_source_identity",
    "artifacts",
    "protected_history"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reference_source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "files"],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/artifact"
      }
    },
    "protected_history": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "location_key",
        "required",
        "contains_locked_data",
        "sha256",
        "size_bytes",
        "claims"
      ],
      "properties": {
        "kind": {
          "enum": ["original", "derivative"]
        },
        "location_key": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "contains_locked_data": {
          "const": false
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_evidence_id": {
          "type": "string"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "derivative"
              }
            }
          },
          "then": {
            "required": ["source_evidence_id", "source_sha256"]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": ["source_evidence_id"]
                },
                {
                  "required": ["source_sha256"]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
